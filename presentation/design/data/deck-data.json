 "times": {
  "1": {
   "time": "1:30",
   "clock": "00:00-01:30",
   "mtitle": "The operation starts before theatre"
  },
  "2": {
   "time": "1:30",
   "clock": "01:30-03:00",
   "mtitle": "The evidence has boundaries"
  },
  "3": {
   "time": "1:45",
   "clock": "03:00-04:45",
   "mtitle": "Define the leakage that matters"
  },
  "4": {
   "time": "1:30",
   "clock": "04:45-06:15",
   "mtitle": "Timing and alternatives: avoid both drift and haste"
  },
  "5": {
   "time": "1:15",
   "clock": "06:15-07:30",
   "mtitle": "Can this patient use this pump in five years?"
  },
  "6": {
   "time": "1:45",
   "clock": "07:30-09:15",
   "mtitle": "Flexible cystoscopy: know what will change the plan"
  },
  "7": {
   "time": "1:45",
   "clock": "09:15-11:00",
   "mtitle": "Urodynamics: the guidelines really do differ"
  },
  "8": {
   "time": "1:45",
   "clock": "11:00-12:45",
   "mtitle": "Read the study in the context of the patient"
  },
  "9": {
   "time": "1:15",
   "clock": "12:45-14:00",
   "mtitle": "Consent to a pathway, not a promise of permanent dryness"
  },
  "10": {
   "time": "1:45",
   "clock": "14:00-15:45",
   "mtitle": "Fictional case 1: six pads, urgency and DO"
  },
  "11": {
   "time": "1:30",
   "clock": "15:45-17:15",
   "mtitle": "Treat urgency without creating an emptying problem"
  },
  "12": {
   "time": "1:45",
   "clock": "17:15-19:00",
   "mtitle": "Fictional case 2: weak contraction and a raised residual"
  },
  "13": {
   "time": "1:30",
   "clock": "19:00-20:30",
   "mtitle": "Intermittent catheterisation changes the consent and the operation"
  },
  "14": {
   "time": "1:30",
   "clock": "20:30-22:00",
   "mtitle": "Poor compliance: dry can still be unsafe"
  },
  "15": {
   "time": "1:15",
   "clock": "22:00-23:15",
   "mtitle": "Name the narrowing before choosing its treatment"
  },
  "16": {
   "time": "1:30",
   "clock": "23:15-24:45",
   "mtitle": "Stability is a finding, not merely elapsed time"
  },
  "17": {
   "time": "1:30",
   "clock": "24:45-26:15",
   "mtitle": "Fictional case 3: radiation and recurrent VUAS"
  },
  "18": {
   "time": "1:30",
   "clock": "26:15-27:45",
   "mtitle": "A reconstructed urethra changes the dissection"
  },
  "19": {
   "time": "1:15",
   "clock": "27:45-29:00",
   "mtitle": "Transcorporal placement is an option with a price"
  },
  "20": {
   "time": "1:15",
   "clock": "29:00-30:15",
   "mtitle": "A fifteen-minute wash: which activity do we mean?"
  },
  "21": {
   "time": "1:45",
   "clock": "30:15-32:00",
   "mtitle": "Skin preparation: what the studies can actually support"
  },
  "22": {
   "time": "1:30",
   "clock": "32:00-33:30",
   "mtitle": "Urine and antibiotics: state the disagreement"
  },
  "23": {
   "time": "1:30",
   "clock": "33:30-35:00",
   "mtitle": "Reduce contamination without turning tradition into proof"
  },
  "24": {
   "time": "1:00",
   "clock": "35:00-36:00",
   "mtitle": "The theatre checklist I would actually use"
  },
  "25": {
   "time": "1:15",
   "clock": "36:00-37:15",
   "mtitle": "Position and expose for the anatomy you have"
  },
  "26": {
   "time": "1:30",
   "clock": "37:15-38:45",
   "mtitle": "Bulbar dissection: preserve the tissue you need to compress"
  },
  "27": {
   "time": "1:45",
   "clock": "38:45-40:30",
   "mtitle": "Measurement: a tighter cuff is not a better measurement"
  },
  "28": {
   "time": "1:30",
   "clock": "40:30-42:00",
   "mtitle": "Urethral injury or contamination: change the endpoint"
  },
  "29": {
   "time": "1:30",
   "clock": "42:00-43:30",
   "mtitle": "Balloon placement and pressure: two different decisions"
  },
  "30": {
   "time": "1:15",
   "clock": "43:30-44:45",
   "mtitle": "The pump must work for the patient"
  },
  "31": {
   "time": "1:15",
   "clock": "44:45-46:00",
   "mtitle": "Finish the system, then hand over the risk"
  },
  "32": {
   "time": "4:00",
   "clock": "46:00-50:00",
   "mtitle": "UroOps 3D: follow the anatomy, then follow the tubing"
  },
  "33": {
   "time": "1:00",
   "clock": "50:00-51:00",
   "mtitle": "Early care: the device is only part of the handover"
  },
  "34": {
   "time": "1:30",
   "clock": "51:00-52:30",
   "mtitle": "Fictional case 4: leakage after three good years"
  },
  "35": {
   "time": "0:45",
   "clock": "52:30-53:15",
   "mtitle": "What we know, what we believe, what we cannot yet answer"
  },
  "36": {
   "time": "0:45",
   "clock": "53:15-54:00",
   "mtitle": "Five decisions before the implant is opened"
  },
  "37": {
